@page "/auth/change-password"
@using ClientBlazor.Models
@using ClientBlazor.Services
@using ClientBlazor.Components.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Cambiar Contraseña - DenounceBeasts</PageTitle>

<AuthGuard>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <i class="bi bi-shield-lock text-warning" style="font-size: 3rem;"></i>
                            <h2 class="mt-3">Cambiar Contraseña</h2>
                            <p class="text-muted">Actualiza tu contraseña para mantener tu cuenta segura</p>
                        </div>

                        <EditForm Model="passwordModel" OnValidSubmit="HandleChangePassword" FormName="ChangePasswordForm">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label">
                                    <i class="bi bi-lock me-1"></i>Contraseña Actual
                                </label>
                                <div class="input-group">
                                    <InputText id="currentPassword" @bind-Value="passwordModel.CurrentPassword" 
                                               type="@(showCurrentPassword ? "text" : "password")"
                                               class="form-control" 
                                               placeholder="Tu contraseña actual" 
                                               autocomplete="current-password" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleCurrentPasswordVisibility">
                                        <i class="bi @(showCurrentPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => passwordModel.CurrentPassword)" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="newPassword" class="form-label">
                                    <i class="bi bi-lock-fill me-1"></i>Nueva Contraseña
                                </label>
                                <div class="input-group">
                                    <InputText id="newPassword" @bind-Value="passwordModel.NewPassword" 
                                               @oninput="OnNewPasswordChanged"
                                               type="@(showNewPassword ? "text" : "password")"
                                               class="form-control" 
                                               placeholder="Mínimo 6 caracteres" 
                                               autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleNewPasswordVisibility">
                                        <i class="bi @(showNewPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => passwordModel.NewPassword)" class="text-danger" />
                                @if (!string.IsNullOrEmpty(passwordModel.NewPassword))
                                {
                                    <div class="mt-2">
                                        <div class="d-flex align-items-center">
                                            <small class="text-muted me-2">Fortaleza:</small>
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar @GetPasswordStrengthClass()" 
                                                     style="width: @(GetPasswordStrength() * 25)%"></div>
                                            </div>
                                            <small class="text-muted ms-2">@GetPasswordStrengthText()</small>
                                        </div>
                                    </div>
                                }
                                <div class="form-text">
                                    <i class="bi bi-info-circle me-1"></i>
                                    La contraseña debe tener al menos 6 caracteres
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="confirmNewPassword" class="form-label">
                                    <i class="bi bi-check-circle me-1"></i>Confirmar Nueva Contraseña
                                </label>
                                <div class="input-group">
                                    <InputText id="confirmNewPassword" @bind-Value="passwordModel.ConfirmNewPassword" 
                                               type="@(showConfirmPassword ? "text" : "password")"
                                               class="form-control" 
                                               placeholder="Repite tu nueva contraseña" 
                                               autocomplete="new-password" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleConfirmPasswordVisibility">
                                        <i class="bi @(showConfirmPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => passwordModel.ConfirmNewPassword)" class="text-danger" />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-warning btn-lg" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Cambiando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-check me-2"></i>
                                        <span>Cambiar Contraseña</span>
                                    }
                                </button>
                                <a href="/auth/profile" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>Volver al Perfil
                                </a>
                            </div>
                        </EditForm>
                    </div>
                </div>
                
                <!-- Password Security Tips -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="bi bi-lightbulb me-2"></i>Consejos de Seguridad
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <i class="bi bi-check text-success me-2"></i>
                                Usa una combinación de letras, números y símbolos
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check text-success me-2"></i>
                                Evita usar información personal fácil de adivinar
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check text-success me-2"></i>
                                No reutilices contraseñas de otras cuentas
                            </li>
                            <li class="mb-0">
                                <i class="bi bi-check text-success me-2"></i>
                                Cambia tu contraseña regularmente
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</AuthGuard>

@code {
    private ChangePasswordModel passwordModel = new();
    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;
    private bool isLoading = false;

    private void ToggleCurrentPasswordVisibility()
    {
        showCurrentPassword = !showCurrentPassword;
    }

    private void ToggleNewPasswordVisibility()
    {
        showNewPassword = !showNewPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private void OnNewPasswordChanged(ChangeEventArgs e)
    {
        passwordModel.NewPassword = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private int GetPasswordStrength()
    {
        var password = passwordModel.NewPassword;
        int strength = 0;

        if (password.Length >= 6) strength += 1;
        if (password.Length >= 8) strength += 1;
        if (password.Any(char.IsLower)) strength += 1;
        if (password.Any(char.IsUpper)) strength += 1;
        if (password.Any(char.IsDigit)) strength += 1;
        if (password.Any(ch => !char.IsLetterOrDigit(ch))) strength += 1;

        return Math.Min(strength, 4);
    }

    private string GetPasswordStrengthClass()
    {
        var strength = GetPasswordStrength();
        return strength switch
        {
            0 or 1 => "bg-danger",
            2 => "bg-warning",
            3 => "bg-info",
            4 => "bg-success",
            _ => "bg-secondary"
        };
    }

    private string GetPasswordStrengthText()
    {
        var strength = GetPasswordStrength();
        return strength switch
        {
            0 or 1 => "Débil",
            2 => "Regular",
            3 => "Buena",
            4 => "Fuerte",
            _ => ""
        };
    }

    private async Task HandleChangePassword()
    {
        // Additional validation
        if (passwordModel.CurrentPassword == passwordModel.NewPassword)
        {
            // This should be handled by custom validation, but we can add it here too
            return;
        }

        isLoading = true;
        
        try
        {
            var request = new ChangePasswordRequest
            {
                CurrentPassword = passwordModel.CurrentPassword,
                NewPassword = passwordModel.NewPassword,
                ConfirmNewPassword = passwordModel.ConfirmNewPassword
            };

            var success = await AuthService.ChangePasswordAsync(request);
            
            if (success)
            {
                // Clear form
                passwordModel = new ChangePasswordModel();
                
                // Redirect to profile
                Navigation.NavigateTo("/auth/profile");
            }
        }
        catch (Exception ex)
        {
            // Error handling is done in the service with toast notifications
            Console.WriteLine($"Change password error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}