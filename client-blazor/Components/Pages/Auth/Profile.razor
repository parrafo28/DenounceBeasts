@page "/auth/profile"
@using ClientBlazor.Models
@using ClientBlazor.Services
@using ClientBlazor.Components.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Mi Perfil - DenounceBeasts</PageTitle>

<AuthGuard>
    <div class="container">
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-body text-center p-4">
                        <div class="mb-3">
                            <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                        </div>
                        <h4 class="card-title">@AuthService.CurrentUser?.FullName</h4>
                        <p class="text-muted">@AuthService.CurrentUser?.Email</p>
                        
                        @if (AuthService.CurrentUser?.Roles.Any() == true)
                        {
                            <div class="mb-3">
                                @foreach (var role in AuthService.CurrentUser.Roles)
                                {
                                    <span class="badge bg-secondary me-1">@role</span>
                                }
                            </div>
                        }
                        
                        <div class="mb-3">
                            <span class="badge @(AuthService.CurrentUser?.IsActive == true ? "bg-success" : "bg-danger")">
                                @(AuthService.CurrentUser?.IsActive == true ? "Activo" : "Inactivo")
                            </span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <a href="/auth/change-password" class="btn btn-outline-primary">
                                <i class="bi bi-key me-2"></i>Cambiar Contraseña
                            </a>
                            <button class="btn btn-outline-danger" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-8">
                <div class="card shadow">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-person-vcard me-2"></i>Información Personal
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted">Nombre</label>
                                <div class="form-control-plaintext">@AuthService.CurrentUser?.FirstName</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted">Apellido</label>
                                <div class="form-control-plaintext">@AuthService.CurrentUser?.LastName</div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted">Email</label>
                                <div class="form-control-plaintext">@AuthService.CurrentUser?.Email</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted">Teléfono</label>
                                <div class="form-control-plaintext">
                                    @(string.IsNullOrEmpty(AuthService.CurrentUser?.Phone) ? "No especificado" : AuthService.CurrentUser.Phone)
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Dirección</label>
                            <div class="form-control-plaintext">
                                @(string.IsNullOrEmpty(AuthService.CurrentUser?.Address) ? "No especificada" : AuthService.CurrentUser.Address)
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card shadow mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-shield-check me-2"></i>Información de Cuenta
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted">ID de Usuario</label>
                                <div class="form-control-plaintext">
                                    <code>@AuthService.CurrentUser?.Id</code>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted">Estado</label>
                                <div class="form-control-plaintext">
                                    <span class="badge @(AuthService.CurrentUser?.IsActive == true ? "bg-success" : "bg-danger")">
                                        @(AuthService.CurrentUser?.IsActive == true ? "Cuenta Activa" : "Cuenta Inactiva")
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        @if (AuthService.CurrentUser?.Roles.Any() == true)
                        {
                            <div class="mb-3">
                                <label class="form-label text-muted">Roles</label>
                                <div class="form-control-plaintext">
                                    @foreach (var role in AuthService.CurrentUser.Roles)
                                    {
                                        <span class="badge bg-info me-1">@role</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</AuthGuard>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Refresh profile data
        if (AuthService.IsAuthenticated)
        {
            await AuthService.GetProfileAsync();
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}