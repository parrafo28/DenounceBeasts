@page "/municipalities/create"
@page "/municipalities/{id:int}/edit"
@using ClientBlazor.Models
@using ClientBlazor.Services
@using Blazored.Toast.Services
@using System.ComponentModel.DataAnnotations
@inject IMunicipalityService MunicipalityService
@inject IToastService ToastService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(IsEdit ? "Editar" : "Crear") Municipio - DenounceBeasts</PageTitle>

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex align-items-center mb-4">
        <button type="button" class="btn btn-outline-secondary me-3" @onclick="GoBack">
            <i class="fas fa-arrow-left"></i> Volver
        </button>
        <div>
            <h1 class="h2 text-primary mb-0">@(IsEdit ? "Editar" : "Crear") Municipio</h1>
            <p class="text-muted mb-0">@(IsEdit ? "Modifica los datos del municipio" : "Completa la información del nuevo municipio")</p>
        </div>
    </div>

    <!-- Formulario -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header @(IsEdit && originalMunicipality != null ? "d-flex justify-content-between align-items-center" : "")">
                    <h5 class="mb-0">Información del Municipio</h5>
                    @if (IsEdit && originalMunicipality != null)
                    {
                        <span class="badge @(originalMunicipality.IsActive ? "bg-success" : "bg-danger")">
                            @(originalMunicipality.IsActive ? "Activo" : "Inactivo")
                        </span>
                    }
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted">Cargando datos del municipio...</p>
                        </div>
                    }
                    else if (IsEdit && originalMunicipality == null)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>
                            <h5>Municipio no encontrado</h5>
                            <p class="text-muted">El municipio que intenta editar no existe o no está disponible.</p>
                            <button type="button" class="btn btn-primary" @onclick="GoBack">
                                <i class="fas fa-arrow-left"></i> Volver a la Lista
                            </button>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="municipalityForm" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="code" class="form-label">Código *</label>
                                    <InputText id="code" class="form-control" @bind-Value="municipalityForm.Code" placeholder="Ejemplo: SD-01" />
                                    <ValidationMessage For="@(() => municipalityForm.Code)" />
                                </div>
                                
                                <div class="col-md-6 mb-3">
                                    <label for="name" class="form-label">Nombre *</label>
                                    <InputText id="name" class="form-control" @bind-Value="municipalityForm.Name" placeholder="Nombre del municipio" />
                                    <ValidationMessage For="@(() => municipalityForm.Name)" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <InputCheckbox id="isActive" class="form-check-input" @bind-Value="municipalityForm.IsActive" />
                                    <label for="isActive" class="form-check-label">
                                        Municipio activo
                                    </label>
                                </div>
                            </div>

                            @if (IsEdit && originalMunicipality != null)
                            {
                                <!-- Información adicional -->
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Sectores registrados</label>
                                        <div class="form-control-plaintext">
                                            <span class="badge bg-info">@originalMunicipality.SectorsCount sectores</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Fecha de creación</label>
                                        <div class="form-control-plaintext">
                                            @originalMunicipality.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                                    <i class="fas fa-times"></i> Cancelar
                                </button>
                                @if (IsEdit)
                                {
                                    <a href="/municipalities/@Id" class="btn btn-outline-info">
                                        <i class="fas fa-eye"></i> Ver Detalles
                                    </a>
                                }
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    <i class="fas fa-save"></i> @(IsEdit ? "Actualizar" : "Crear") Municipio
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id.HasValue;
    private bool isLoading = false;
    private bool isSaving = false;
    private MunicipalityDto? originalMunicipality;
    private MunicipalityFormModel municipalityForm = new();

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            await LoadMunicipality();
        }
        else
        {
            municipalityForm = new MunicipalityFormModel
            {
                IsActive = true
            };
        }
    }

    private async Task LoadMunicipality()
    {
        if (!Id.HasValue) return;

        try
        {
            isLoading = true;
            originalMunicipality = await MunicipalityService.GetByIdAsync(Id.Value);
            
            if (originalMunicipality != null)
            {
                municipalityForm = new MunicipalityFormModel
                {
                    Code = originalMunicipality.Code,
                    Name = originalMunicipality.Name,
                    IsActive = originalMunicipality.IsActive
                };
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Error al cargar el municipio. Por favor, intente nuevamente.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSaving = true;

            // Verificar si el código es único
            var excludeId = IsEdit ? Id : null;
            var isCodeUnique = await MunicipalityService.IsCodeUniqueAsync(municipalityForm.Code, excludeId);
            
            if (!isCodeUnique)
            {
                ToastService.ShowError("Ya existe un municipio con este código.");
                return;
            }

            if (IsEdit)
            {
                var updateDto = new UpdateMunicipalityDto
                {
                    Code = municipalityForm.Code.Trim(),
                    Name = municipalityForm.Name.Trim(),
                    IsActive = municipalityForm.IsActive
                };

                await MunicipalityService.UpdateAsync(Id!.Value, updateDto);
                ToastService.ShowSuccess("El municipio fue actualizado exitosamente.");
            }
            else
            {
                var createDto = new CreateMunicipalityDto
                {
                    Code = municipalityForm.Code.Trim(),
                    Name = municipalityForm.Name.Trim(),
                    IsActive = municipalityForm.IsActive
                };

                await MunicipalityService.CreateAsync(createDto);
                ToastService.ShowSuccess("El municipio fue creado exitosamente.");
            }

            Navigation.NavigateTo("/municipalities");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al {(IsEdit ? "actualizar" : "crear")} el municipio. Por favor, intente nuevamente.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/municipalities");
    }

    public class MunicipalityFormModel
    {
        [Required(ErrorMessage = "El código es requerido")]
        [StringLength(10, MinimumLength = 2, ErrorMessage = "El código debe tener entre 2 y 10 caracteres")]
        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es requerido")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "El nombre debe tener entre 2 y 100 caracteres")]
        public string Name { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;
    }
}