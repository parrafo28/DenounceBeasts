@model DenounceBeasts.WebClient.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="card-title">@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted">@Model.Email</p>
                    
                    @if (Model.Roles.Any())
                    {
                        <div class="mb-3">
                            @foreach (var role in Model.Roles)
                            {
                                <span class="badge bg-secondary me-1">@role</span>
                            }
                        </div>
                    }
                    
                    <div class="mb-3">
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                            @(Model.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a asp-action="ChangePassword" class="btn btn-outline-primary">
                            <i class="bi bi-key me-2"></i>Cambiar Contraseña
                        </a>
                        <form asp-action="Logout" asp-controller="Auth" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100" 
                                    onclick="return confirm('¿Estás seguro que deseas cerrar sesión?')">
                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-person-vcard me-2"></i>Información Personal
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Nombre</label>
                            <div class="form-control-plaintext">@Model.FirstName</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Apellido</label>
                            <div class="form-control-plaintext">@Model.LastName</div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Email</label>
                            <div class="form-control-plaintext">@Model.Email</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Teléfono</label>
                            <div class="form-control-plaintext">
                                @(string.IsNullOrEmpty(Model.Phone) ? "No especificado" : Model.Phone)
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-muted">Dirección</label>
                        <div class="form-control-plaintext">
                            @(string.IsNullOrEmpty(Model.Address) ? "No especificada" : Model.Address)
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card shadow mt-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-check me-2"></i>Información de Cuenta
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">ID de Usuario</label>
                            <div class="form-control-plaintext">
                                <code>@Model.Id</code>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Estado</label>
                            <div class="form-control-plaintext">
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                    @(Model.IsActive ? "Cuenta Activa" : "Cuenta Inactiva")
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    @if (Model.Roles.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label text-muted">Roles</label>
                            <div class="form-control-plaintext">
                                @foreach (var role in Model.Roles)
                                {
                                    <span class="badge bg-info me-1">@role</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-hide success/error messages after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
}