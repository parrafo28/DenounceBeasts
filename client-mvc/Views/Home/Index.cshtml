@{
    ViewData["Title"] = "Dashboard";
    var dashboardData = ViewBag.DashboardData;
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="display-6 mb-0">
            <i class="fas fa-chart-line text-primary me-3"></i>
            Dashboard de Denuncias Ciudadanas
        </h1>
        <p class="lead text-muted">Panel de control y estadísticas del sistema</p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-5">
    <div class="col-md-3 mb-3">
        <div class="card stats-card h-100">
            <div class="card-body text-center">
                <i class="fas fa-city fa-3x mb-3 opacity-75"></i>
                <h2 class="fw-bold mb-1">@(dashboardData?.TotalMunicipalities ?? 0)</h2>
                <p class="mb-1">Municipios</p>
                <small class="opacity-75">@(dashboardData?.ActiveMunicipalities ?? 0) activos</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
            <div class="card-body text-center">
                <i class="fas fa-map fa-3x mb-3 opacity-75"></i>
                <h2 class="fw-bold mb-1">@(dashboardData?.TotalSectors ?? 0)</h2>
                <p class="mb-1">Sectores</p>
                <small class="opacity-75">@(dashboardData?.ActiveSectors ?? 0) activos</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card h-100" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
            <div class="card-body text-center">
                <i class="fas fa-exclamation-triangle fa-3x mb-3 opacity-75"></i>
                <h2 class="fw-bold mb-1">@(dashboardData?.TotalComplaints ?? 0)</h2>
                <p class="mb-1">Denuncias</p>
                <small class="opacity-75">@(dashboardData?.ActiveComplaints ?? 0) activas</small>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card h-100" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white;">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-3x mb-3 opacity-75"></i>
                <h2 class="fw-bold mb-1">@(dashboardData?.RecentComplaints?.Count() ?? 0)</h2>
                <p class="mb-1">Esta Semana</p>
                <small class="opacity-75">últimos 7 días</small>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-5">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-rocket me-2"></i>
                    Acciones Rápidas
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <a asp-controller="Municipalities" asp-action="Create" class="btn btn-outline-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3">
                            <i class="fas fa-plus-circle fa-2x mb-2"></i>
                            <span>Nuevo Municipio</span>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a asp-controller="Sectors" asp-action="Create" class="btn btn-outline-success w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3">
                            <i class="fas fa-map-marked-alt fa-2x mb-2"></i>
                            <span>Nuevo Sector</span>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a asp-controller="Complaints" asp-action="Create" class="btn btn-outline-warning w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3">
                            <i class="fas fa-bullhorn fa-2x mb-2"></i>
                            <span>Nueva Denuncia</span>
                        </a>
                    </div>
                    <div class="col-md-3 mb-3">
                        <a asp-controller="Municipalities" asp-action="Index" class="btn btn-outline-info w-100 h-100 d-flex flex-column align-items-center justify-content-center py-3">
                            <i class="fas fa-search fa-2x mb-2"></i>
                            <span>Buscar Datos</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Complaints -->
@if (dashboardData?.RecentComplaints != null && dashboardData.RecentComplaints.Any())
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-history me-2 text-primary"></i>
                            Denuncias Recientes
                        </h5>
                        <a asp-controller="Complaints" asp-action="Index" class="btn btn-outline-primary btn-sm">
                            Ver Todas
                            <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Título</th>
                                    <th>Municipio</th>
                                    <th>Tipo</th>
                                    <th>Estado</th>
                                    <th>Prioridad</th>
                                    <th>Fecha</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var complaint in dashboardData.RecentComplaints)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@complaint.Title</div>
                                            <small class="text-muted">@complaint.Description.Substring(0, Math.Min(50, complaint.Description.Length))...</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@(complaint.MunicipalityName ?? "N/A")</span>
                                        </td>
                                        <td>@(complaint.ComplaintTypeName ?? "N/A")</td>
                                        <td>
                                            <span class="badge" style="background-color: @(complaint.StatusColor ?? "#6c757d")">
                                                @(complaint.StatusName ?? "N/A")
                                            </span>
                                        </td>
                                        <td>
                                            @{
                                                var priorityClass = complaint.Priority switch
                                                {
                                                    Priority.Low => "badge-success",
                                                    Priority.Medium => "badge-warning",
                                                    Priority.High => "badge-danger",
                                                    Priority.Critical => "badge-dark",
                                                    _ => "badge-secondary"
                                                };
                                                var priorityText = complaint.Priority switch
                                                {
                                                    Priority.Low => "Baja",
                                                    Priority.Medium => "Media",
                                                    Priority.High => "Alta",
                                                    Priority.Critical => "Crítica",
                                                    _ => "N/A"
                                                };
                                            }
                                            <span class="badge @priorityClass">@priorityText</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">@complaint.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td>
                                            <a asp-controller="Complaints" asp-action="Details" asp-route-id="@complaint.Id" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No hay denuncias recientes</h5>
                    <p class="text-muted">Las denuncias de los últimos 7 días aparecerán aquí</p>
                    <a asp-controller="Complaints" asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>
                        Crear Primera Denuncia
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- System Information -->
<div class="row mt-5">
    <div class="col-12">
        <div class="card border-0 bg-light">
            <div class="card-body text-center py-4">
                <h6 class="text-muted mb-3">
                    <i class="fas fa-info-circle me-2"></i>
                    Sistema de Denuncias Ciudadanas
                </h6>
                <div class="row">
                    <div class="col-md-4">
                        <small class="text-muted">
                            <i class="fas fa-code me-1"></i>
                            ASP.NET Core MVC
                        </small>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">
                            <i class="fas fa-database me-1"></i>
                            API REST
                        </small>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">
                            <i class="fas fa-mobile-alt me-1"></i>
                            Responsive Design
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>