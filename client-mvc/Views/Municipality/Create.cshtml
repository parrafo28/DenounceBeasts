@model Municipality
@{
    ViewData["Title"] = "Agregar Municipio";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-plus-circle"></i> Agregar Municipio</h2>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver a la lista
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-geo-alt"></i> Información del Municipio</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <!-- Token antifalsificación -->
                    @Html.AntiForgeryToken()
                    
                    <!-- Validación general -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <!-- Campo Nombre -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            <i class="bi bi-building"></i> Nombre del Municipio *
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Ingrese el nombre del municipio" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Campo Código -->
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label">
                            <i class="bi bi-hash"></i> Código *
                        </label>
                        <input asp-for="Code" class="form-control" placeholder="Ingrese el código del municipio" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                        <div class="form-text">
                            <i class="bi bi-info-circle"></i> Código único que identifica al municipio
                        </div>
                    </div>

                    <!-- Campo Estado -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">
                                <i class="bi bi-check-circle"></i> Municipio activo
                            </label>
                        </div>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                        <div class="form-text">
                            <i class="bi bi-info-circle"></i> Los municipios activos aparecerán en las listas de selección
                        </div>
                    </div>

                    <!-- Botones de acción -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Guardar Municipio
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Panel de ayuda -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6><i class="bi bi-question-circle"></i> Ayuda</h6>
            </div>
            <div class="card-body">
                <h6>Campos requeridos:</h6>
                <ul class="list-unstyled">
                    <li><i class="bi bi-dot"></i> <strong>Nombre:</strong> Denominación oficial del municipio</li>
                    <li><i class="bi bi-dot"></i> <strong>Código:</strong> Identificador único alfanumérico</li>
                </ul>
                
                <h6 class="mt-3">Recomendaciones:</h6>
                <ul class="list-unstyled">
                    <li><i class="bi bi-dot"></i> Use nombres oficiales completos</li>
                    <li><i class="bi bi-dot"></i> Los códigos deben ser únicos</li>
                    <li><i class="bi bi-dot"></i> Marque como activo si está operativo</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Validación del lado del cliente -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Enfocar el primer campo al cargar
            $('#Name').focus();
            
            // Validación personalizada en tiempo real
            $('#Name').on('input', function() {
                const value = $(this).val().trim();
                if (value.length > 0 && value.length < 3) {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid');
                }
            });
            
            // Convertir código a mayúsculas automáticamente
            $('#Code').on('input', function() {
                $(this).val($(this).val().toUpperCase());
            });
        });
    </script>
}