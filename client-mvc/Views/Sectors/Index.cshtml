@model SectorListViewModel
@{
    ViewData["Title"] = "Gestión de Sectores";
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2 class="mb-0">
            <i class="fas fa-map text-primary me-2"></i>
            Gestión de Sectores
        </h2>
        <p class="text-muted">Administre los sectores por municipio</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>
            Nuevo Sector
        </a>
    </div>
</div>

<!-- Search and Filters -->
<div class="row mb-4">
    <div class="col-md-4">
        <form asp-action="Index" method="get" class="d-flex">
            <div class="search-container flex-grow-1 me-2">
                <i class="fas fa-search"></i>
                <input type="text" class="form-control" name="search" value="@Model.SearchQuery" 
                       placeholder="Buscar sectores...">
            </div>
            <input type="hidden" name="municipalityId" value="@Model.MunicipalityFilter">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="fas fa-search"></i>
            </button>
        </form>
    </div>
    <div class="col-md-4">
        <form asp-action="Index" method="get">
            <input type="hidden" name="search" value="@Model.SearchQuery">
            <select name="municipalityId" class="form-select" onchange="this.form.submit()">
                <option value="">Todos los municipios</option>
                @foreach (var municipality in Model.Municipalities)
                {
                    <option value="@municipality.Value" selected="@municipality.Selected">
                        @municipality.Text
                    </option>
                }
            </select>
        </form>
    </div>
    <div class="col-md-4">
        <div class="d-flex justify-content-end align-items-center">
            <span class="badge bg-primary fs-6">Total: @Model.TotalCount</span>
            <span class="badge bg-success fs-6 ms-1">Activos: @Model.ActiveCount</span>
            <span class="badge bg-secondary fs-6 ms-1">Inactivos: @Model.InactiveCount</span>
        </div>
    </div>
</div>

<!-- Clear Filters -->
@if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.MunicipalityFilter.HasValue)
{
    <div class="row mb-3">
        <div class="col-12">
            <div class="alert alert-info d-flex justify-content-between align-items-center">
                <span>
                    <i class="fas fa-filter me-2"></i>
                    Filtros aplicados: 
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <span class="badge bg-primary ms-1">Búsqueda: "@Model.SearchQuery"</span>
                    }
                    @if (Model.MunicipalityFilter.HasValue)
                    {
                        <span class="badge bg-info ms-1">Municipio filtrado</span>
                    }
                </span>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-times me-1"></i>
                    Limpiar Filtros
                </a>
            </div>
        </div>
    </div>
}

<!-- Sectors Table -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Sectors.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Código</th>
                            <th>Municipio</th>
                            <th>Estado</th>
                            <th>Denuncias</th>
                            <th>Creado</th>
                            <th width="180">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sector in Model.Sectors)
                        {
                            <tr>
                                <td class="fw-semibold">#@sector.Id</td>
                                <td>
                                    <div class="fw-semibold">@sector.Name</div>
                                </td>
                                <td>
                                    <code class="bg-light px-2 py-1 rounded">@sector.Code</code>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        <i class="fas fa-city me-1"></i>
                                        @(sector.MunicipalityName ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    @if (sector.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-times-circle me-1"></i>
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (sector.ComplaintsCount > 0)
                                    {
                                        <span class="badge bg-warning">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            @sector.ComplaintsCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">0</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @sector.CreatedAt.ToString("dd/MM/yyyy")
                                    </small>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@sector.Id" 
                                           class="btn btn-sm btn-outline-info" title="Ver Detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@sector.Id" 
                                           class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@sector.Id" 
                                           class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-map fa-3x text-muted mb-3"></i>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.MunicipalityFilter.HasValue)
                {
                    <h5 class="text-muted">No se encontraron sectores</h5>
                    <p class="text-muted">No hay sectores que coincidan con los filtros aplicados</p>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>
                        Ver Todos los Sectores
                    </a>
                }
                else
                {
                    <h5 class="text-muted">No hay sectores registrados</h5>
                    <p class="text-muted">Comience creando el primer sector del sistema</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>
                        Crear Primer Sector
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-submit search form with delay
            let searchTimeout;
            $('input[name="search"]').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    $('form').first().submit();
                }, 500);
            });

            // Confirm delete actions
            $('a[href*="/Delete/"]').click(function(e) {
                if (!confirmDelete('¿Está seguro de eliminar este sector? Esta acción no se puede deshacer.')) {
                    e.preventDefault();
                }
            });

            // Add tooltips
            $('[title]').tooltip();
        });
    </script>
}