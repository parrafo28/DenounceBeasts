{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ApiSettings": {
    "BaseUrl": "https://localhost:7175",
    "Timeout": 30,
    "RetryAttempts": 3,
    "CacheTimeout": 300
  },
  "AllowedHosts": "*",
  "Session": {
    "Timeout": 30
  },
  "Cache": {
    "DefaultExpiration": 300,
    "SlidingExpiration": 60
  }
}