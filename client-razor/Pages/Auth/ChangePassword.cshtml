@page "/auth/change-password"
@model client_razor.Pages.Auth.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-lock text-warning" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Cambiar Contraseña</h2>
                        <p class="text-muted">Actualiza tu contraseña para mantener tu cuenta segura</p>
                    </div>

                    <form method="post" id="changePasswordForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="PasswordRequest.CurrentPassword" class="form-label">
                                <i class="bi bi-lock me-1"></i>Contraseña Actual
                            </label>
                            <div class="input-group">
                                <input asp-for="PasswordRequest.CurrentPassword" class="form-control" 
                                       placeholder="Tu contraseña actual" autocomplete="current-password" />
                                <button type="button" class="btn btn-outline-secondary" id="toggleCurrentPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordRequest.CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PasswordRequest.NewPassword" class="form-label">
                                <i class="bi bi-lock-fill me-1"></i>Nueva Contraseña
                            </label>
                            <div class="input-group">
                                <input asp-for="PasswordRequest.NewPassword" class="form-control" 
                                       placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" id="toggleNewPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordRequest.NewPassword" class="text-danger"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                La contraseña debe tener al menos 6 caracteres
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PasswordRequest.ConfirmNewPassword" class="form-label">
                                <i class="bi bi-check-circle me-1"></i>Confirmar Nueva Contraseña
                            </label>
                            <div class="input-group">
                                <input asp-for="PasswordRequest.ConfirmNewPassword" class="form-control" 
                                       placeholder="Repite tu nueva contraseña" autocomplete="new-password" />
                                <button type="button" class="btn btn-outline-secondary" id="toggleConfirmPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PasswordRequest.ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg" id="changePasswordButton">
                                <span class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                                <i class="bi bi-shield-check me-2"></i>
                                Cambiar Contraseña
                            </button>
                            <a asp-page="/Auth/Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Volver al Perfil
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Password Security Tips -->
            <div class="card mt-4">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="bi bi-lightbulb me-2"></i>Consejos de Seguridad
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check text-success me-2"></i>
                            Usa una combinación de letras, números y símbolos
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check text-success me-2"></i>
                            Evita usar información personal fácil de adivinar
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check text-success me-2"></i>
                            No reutilices contraseñas de otras cuentas
                        </li>
                        <li class="mb-0">
                            <i class="bi bi-check text-success me-2"></i>
                            Cambia tu contraseña regularmente
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Toggle password visibility functions
            function togglePasswordField(fieldId, buttonId) {
                $(buttonId).click(function() {
                    const passwordField = $(fieldId);
                    const icon = $(this).find('i');
                    
                    if (passwordField.attr('type') === 'password') {
                        passwordField.attr('type', 'text');
                        icon.removeClass('bi-eye').addClass('bi-eye-slash');
                    } else {
                        passwordField.attr('type', 'password');
                        icon.removeClass('bi-eye-slash').addClass('bi-eye');
                    }
                });
            }
            
            // Initialize password toggles
            togglePasswordField('#PasswordRequest_CurrentPassword', '#toggleCurrentPassword');
            togglePasswordField('#PasswordRequest_NewPassword', '#toggleNewPassword');
            togglePasswordField('#PasswordRequest_ConfirmNewPassword', '#toggleConfirmPassword');

            // Form submission with loading state
            $('#changePasswordForm').on('submit', function() {
                const button = $('#changePasswordButton');
                const spinner = button.find('.spinner-border');
                
                button.prop('disabled', true);
                spinner.removeClass('d-none');
                
                // Re-enable after 10 seconds in case of error
                setTimeout(function() {
                    button.prop('disabled', false);
                    spinner.addClass('d-none');
                }, 10000);
            });

            // Auto-focus current password field
            $('#PasswordRequest_CurrentPassword').focus();
        });
    </script>
}