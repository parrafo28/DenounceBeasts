@page "/sectors/{id:int}"
@model client_razor.Pages.Sectors.DetailsModel
@{
    ViewData["Title"] = "Detalle del Sector";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <a asp-page="Index" class="btn btn-outline-secondary me-3">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
            <div>
                <h1 class="h2 text-primary mb-0">@ViewData["Title"]</h1>
                <p class="text-muted mb-0">Información completa del sector</p>
            </div>
        </div>
        
        @if (Model.Sector != null)
        {
            <div class="d-flex gap-2">
                <a asp-page="Edit" asp-route-id="@Model.Sector.Id" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Editar
                </a>
                <button type="button" class="btn btn-danger" onclick="confirmDelete(@Model.Sector.Id, '@Model.Sector.Name')">
                    <i class="fas fa-trash"></i> Eliminar
                </button>
            </div>
        }
    </div>

    @if (Model.Sector != null)
    {
        <div class="row">
            <!-- Información básica del sector -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Información Básica</h5>
                        <span class="badge @(Model.Sector.IsActive ? "bg-success" : "bg-danger") fs-6">
                            @(Model.Sector.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Código</label>
                                <div class="form-control-plaintext">@Model.Sector.Code</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Nombre</label>
                                <div class="form-control-plaintext">@Model.Sector.Name</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Municipio</label>
                                <div class="form-control-plaintext">
                                    @if (Model.Municipality != null)
                                    {
                                        <a asp-page="/Municipalities/Details" asp-route-id="@Model.Municipality.Id" 
                                           class="text-decoration-none">
                                            @Model.Municipality.Name
                                        </a>
                                        @if (!Model.Municipality.IsActive)
                                        {
                                            <span class="badge bg-warning ms-2">Municipio Inactivo</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No encontrado</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Estado</label>
                                <div class="form-control-plaintext">
                                    <span class="badge @(Model.Sector.IsActive ? "bg-success" : "bg-danger") fs-6">
                                        @(Model.Sector.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Fecha de Creación</label>
                                <div class="form-control-plaintext">@Model.Sector.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Última Actualización</label>
                                <div class="form-control-plaintext">@Model.Sector.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información del municipio -->
            <div class="col-lg-4">
                @if (Model.Municipality != null)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">Información del Municipio</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Código del Municipio</label>
                                <div class="form-control-plaintext">@Model.Municipality.Code</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Estado del Municipio</label>
                                <div class="form-control-plaintext">
                                    <span class="badge @(Model.Municipality.IsActive ? "bg-success" : "bg-danger")">
                                        @(Model.Municipality.IsActive ? "Activo" : "Inactivo")
                                    </span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Total de Sectores</label>
                                <div class="form-control-plaintext">
                                    <span class="badge bg-info">@Model.Municipality.SectorsCount sectores</span>
                                </div>
                            </div>
                            <div class="text-center">
                                <a asp-page="/Municipalities/Details" asp-route-id="@Model.Municipality.Id" 
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> Ver Municipio
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Otros sectores del mismo municipio -->
        @if (Model.Municipality != null)
        {
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Otros Sectores del Municipio</h5>
                    <a asp-page="Create" asp-route-municipalityId="@Model.Municipality.Id" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus"></i> Agregar Otro Sector
                    </a>
                </div>
                <div class="card-body">
                    @if (!Model.OtherSectors.Any())
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">No hay otros sectores en este municipio.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Código</th>
                                        <th>Nombre</th>
                                        <th>Estado</th>
                                        <th>Fecha Creación</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var otherSector in Model.OtherSectors)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold">@otherSector.Code</span>
                                            </td>
                                            <td>@otherSector.Name</td>
                                            <td>
                                                @if (otherSector.IsActive)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactivo</span>
                                                }
                                            </td>
                                            <td>@otherSector.CreatedAt.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-page="Details" asp-route-id="@otherSector.Id" 
                                                       class="btn btn-sm btn-outline-info" title="Ver detalles">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-page="Edit" asp-route-id="@otherSector.Id" 
                                                       class="btn btn-sm btn-outline-primary" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <!-- Estado de error -->
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-exclamation-triangle text-warning fa-3x mb-3"></i>
                        <h5>Sector no encontrado</h5>
                        <p class="text-muted">El sector que busca no existe o no está disponible.</p>
                        <a asp-page="Index" class="btn btn-primary">
                            <i class="fas fa-arrow-left"></i> Volver a la Lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Está seguro que desea eliminar el sector <strong id="sectorNameToDelete"></strong>?</p>
                <p class="text-muted">Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" style="display: inline;">
                    <input type="hidden" name="id" id="sectorIdToDelete" />
                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('sectorIdToDelete').value = id;
            document.getElementById('sectorNameToDelete').textContent = name;
            
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        // Mostrar mensajes de éxito/error
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                toastr.success('@TempData["SuccessMessage"]');
            </text>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                toastr.error('@TempData["ErrorMessage"]');
            </text>
        }
    </script>
}