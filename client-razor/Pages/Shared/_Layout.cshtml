<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DenounceBeasts Razor Pages</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <!-- SweetAlert2 para alertas elegantes -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Estilos personalizados -->
    <style>
        .header-bg {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
            padding: 1rem 0;
        }
        
        .navbar-brand {
            font-weight: bold;
            font-size: 1.4rem;
        }
        
        .main-content {
            min-height: calc(100vh - 200px);
            padding: 2rem 0;
        }
        
        .card {
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border: none;
            border-radius: 10px;
        }
        
        .btn-custom {
            border-radius: 25px;
            padding: 8px 20px;
        }
        
        .footer {
            background: #f8f9fa;
            padding: 2rem 0;
            margin-top: 3rem;
            border-top: 1px solid #dee2e6;
        }
        
        .alert {
            border-radius: 10px;
            border: none;
        }
        
        .pagination .page-link {
            color: #28a745;
            border: 1px solid #28a745;
            border-radius: 25px;
            margin: 0 2px;
        }
        
        .pagination .page-item.active .page-link {
            background-color: #28a745;
            border-color: #28a745;
        }
        
        .pagination .page-link:hover {
            background-color: #20c997;
            border-color: #20c997;
        }
        
        .table-hover tbody tr:hover {
            background-color: rgba(40, 167, 69, 0.1);
        }
        
        .nav-link:hover {
            color: #f8f9fa !important;
        }
        
        .badge {
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <!-- Header con navegación -->
    <header class="header-bg">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-building"></i> DenounceBeasts Razor
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">
                                <i class="bi bi-house-door"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Municipality">
                                <i class="bi bi-geo-alt-fill"></i> Municipios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/District">
                                <i class="bi bi-map-fill"></i> Distritos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/About">
                                <i class="bi bi-info-circle"></i> Acerca de
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <main class="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <h5>
                        <i class="bi bi-building text-success"></i> DenounceBeasts Razor Pages
                    </h5>
                    <p class="text-muted mb-0">
                        Sistema de gestión territorial desarrollado con ASP.NET Core Razor Pages.
                        Implementa el patrón Page-Based para una experiencia de desarrollo más simple.
                    </p>
                </div>
                <div class="col-md-4 text-end">
                    <p class="text-muted mb-0">
                        <i class="bi bi-calendar3"></i> @DateTime.Now.Year
                    </p>
                    <p class="text-muted mb-0">
                        <i class="bi bi-code-slash"></i> Proyecto educativo ITLA
                    </p>
                    <p class="text-muted mb-0">
                        <i class="bi bi-file-earmark-code"></i> Razor Pages Pattern
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS y dependencias -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery para facilitar manipulación del DOM -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- Scripts globales -->
    <script>
        // Configuración global para SweetAlert
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        // Función para mostrar confirmación de eliminación
        function confirmDelete(url, itemName, itemType = 'elemento') {
            Swal.fire({
                title: '¿Estás seguro?',
                text: `¿Deseas eliminar ${itemType} "${itemName}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar',
                reverseButtons: true,
                focusCancel: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // Mostrar loading
                    Swal.fire({
                        title: 'Eliminando...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                    
                    // Enviar formulario
                    window.location.href = url;
                }
            });
        }

        // Función para mostrar notificaciones de éxito
        function showSuccess(message) {
            Toast.fire({
                icon: 'success',
                title: message
            });
        }

        // Función para mostrar notificaciones de error
        function showError(message) {
            Toast.fire({
                icon: 'error',
                title: message
            });
        }

        // Función para mostrar notificaciones de información
        function showInfo(message) {
            Toast.fire({
                icon: 'info',
                title: message
            });
        }

        // Inicialización cuando el DOM esté listo
        $(document).ready(function() {
            // Auto-ocultar alertas de Bootstrap después de 5 segundos
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
            
            // Animación suave para los enlaces internos
            $('a[href^="#"]').on('click', function(e) {
                e.preventDefault();
                var target = this.hash;
                $('html, body').animate({
                    scrollTop: $(target).offset().top - 100
                }, 500);
            });
            
            // Efecto hover para las tarjetas
            $('.card').hover(
                function() {
                    $(this).animate({
                        transform: 'translateY(-5px)'
                    }, 200);
                },
                function() {
                    $(this).animate({
                        transform: 'translateY(0)'
                    }, 200);
                }
            );
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>