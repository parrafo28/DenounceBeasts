{
  "name": "dennouncebeasts-typescript",
  "version": "1.0.0",
  "description": "DenounceBeasts TypeScript Pure Client Application",
  "main": "dist/main.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "serve": "webpack serve --mode development --open",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.{ts,html,css,scss}",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.10.0",
    "sweetalert2": "^11.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.47.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.6.2",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^3.0.2",
    "rimraf": "^5.0.1",
    "sass": "^1.66.1",
    "sass-loader": "^13.3.2",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "keywords": [
    "typescript",
    "vanilla",
    "crud",
    "educational",
    "webpack",
    "bootstrap",
    "api-client"
  ],
  "author": "ITLA Students",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/dennouncebeasts-typescript"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}